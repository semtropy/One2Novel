{
  "name": "one2novel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:generate": "pnpm --filter @one2novel/server db:generate",
    "db:migrate": "pnpm --filter @one2novel/server db:migrate",
    "build": "pnpm db:generate && pnpm --filter @one2novel/server build && pnpm --filter @one2novel/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "pnpm --filter @one2novel/server start"
  },
  "devDependencies": {
    "@one2novel/contracts": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "better-sqlite3": "^12.6.2",
    "prettier": "3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}

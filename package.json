{
  "name": "one2novel",
  "private": true,
  "description": "从一句灵感到一本小说 — AI 驱动的长篇小说创作工作台",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "pnpm": ">=10.6.0"
  },
  "scripts": {
    "dev": "pnpm dev:server & sleep 4 && pnpm dev:client",
    "dev:server": "pnpm --filter @one2novel/server dev",
    "dev:client": "pnpm --filter @one2novel/client dev",
    "build": "pnpm --filter @one2novel/shared build && pnpm --filter @one2novel/server build && pnpm --filter @one2novel/client build",
    "db:push": "pnpm --filter @one2novel/server db:push",
    "db:studio": "pnpm --filter @one2novel/server db:studio",
    "typecheck": "pnpm --filter @one2novel/shared build && pnpm --filter @one2novel/server typecheck && pnpm --filter @one2novel/client typecheck && pnpm --filter @one2novel/desktop typecheck",
    "test": "pnpm --filter @one2novel/server test",
    "prepare:desktop-runtime": "pnpm --filter @one2novel/desktop prepare:runtime",
    "dev:desktop": "pnpm run build:desktop:all && pnpm --filter @one2novel/desktop dev",
    "build:desktop": "pnpm --filter @one2novel/desktop build",
    "build:desktop:all": "pnpm --filter @one2novel/shared build && pnpm --filter @one2novel/server prisma:generate && pnpm --filter @one2novel/server build && pnpm --filter @one2novel/client build:desktop && pnpm --filter @one2novel/desktop build",
    "stage:desktop": "pnpm run build:desktop:all && node desktop/scripts/stage-desktop.cjs",
    "dist:desktop:nsis": "pnpm run stage:desktop && node desktop/scripts/run-electron-builder.cjs --win nsis --x64",
    "dist:desktop:nsis:reuse-stage": "node desktop/scripts/run-electron-builder.cjs --win nsis --x64",
    "dist:desktop": "pnpm run stage:desktop && node desktop/scripts/run-electron-builder.cjs --win --x64",
    "dist:desktop:reuse-stage": "node desktop/scripts/run-electron-builder.cjs --win --x64",
    "dist:desktop:portable": "pnpm run stage:desktop && node desktop/scripts/run-electron-builder.cjs --win portable --x64",
    "dist:desktop:portable:reuse-stage": "node desktop/scripts/run-electron-builder.cjs --win portable --x64",
    "publish:desktop:beta": "pnpm run stage:desktop && node desktop/scripts/publish-desktop-beta.cjs",
    "publish:desktop:beta:reuse-stage": "node desktop/scripts/publish-desktop-beta.cjs",
    "publish:desktop:release": "pnpm run stage:desktop && node desktop/scripts/publish-desktop-release.cjs",
    "publish:desktop:release:reuse-stage": "node desktop/scripts/publish-desktop-release.cjs",
    "release:desktop:github": "node scripts/trigger-desktop-release.cjs",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs}\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
